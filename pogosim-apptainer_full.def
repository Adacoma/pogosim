Bootstrap: docker
From: ubuntu:24.04

%labels
    Author leo.cazenille@gmail.com
    Version 0.1.0

%arguments
    USE_CLANG="false"

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export DEBIAN_FRONTEND=noninteractive
    export CMAKE_MODULE_PATH="/opt/pogosim/cmake/modules"
    export LD_LIBRARY_PATH="/usr/local/lib:$LD_LIBRARY_PATH"
    export PATH="/usr/local/bin:$PATH:/pogobot-sdk/tools/riscv64-unknown-elf-gcc-10.1.0-2020.08.2-x86_64-linux-ubuntu14/bin"
    export NPROC=$(grep -i "^processor" /proc/cpuinfo | wc -l)
    export POGO_SDK=/pogobot-sdk
    export POGOSIM_INCLUDE_DIR=/opt/pogosim/src
    export POGOSIM_SRC_DIR=/opt/pogosim/src/pogosim
    export POGOUTILS_INCLUDE_DIR=/opt/pogo-utils/src
    export POGOUTILS_SRC_DIR=/opt/pogo-utils/src/pogo-utils

%post
    set -eu

    echo 'Acquire::Retries "10";' > /etc/apt/apt.conf.d/80-retries

    # Update and install required packages.
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        libboost-system-dev \
        libsdl2-dev \
        libsdl2-image-dev \
        libsdl2-gfx-dev \
        libsdl2-ttf-dev \
        libyaml-cpp-dev \
        libspdlog-dev \
        libfmt-dev \
        pkg-config \
        wget \
        unzip \
        ca-certificates \
        lsb-release

    # Install Apache Arrow.
    wget https://apache.jfrog.io/artifactory/arrow/$(lsb_release --id --short | tr 'A-Z' 'a-z')/apache-arrow-apt-source-latest-$(lsb_release --codename --short).deb
    apt-get install -y -V ./apache-arrow-apt-source-latest-$(lsb_release --codename --short).deb
    apt-get update
    apt-get install -y -V libarrow-dev

    # Install clang if USE_CLANG is true.
    if [ "{{ USE_CLANG }}" = "true" ]; then
        apt-get install -y --no-install-recommends clang
        update-alternatives --install /usr/bin/cc cc /usr/bin/clang 100
        update-alternatives --install /usr/bin/c++ c++ /usr/bin/clang++ 100
    fi

    # Install the Box2D 3.x revision used by Pogosim.
    cd /tmp
    git clone https://github.com/erincatto/box2d.git
    cd box2d
    git checkout 28adacf82377d4113f2ed00586141463244b9d10
    mkdir build
    cd build
    cmake \
        -DBOX2D_SAMPLES=OFF \
        -DBOX2D_UNIT_TESTS=OFF \
        -DBOX2D_DOCS=OFF \
        -DCMAKE_INSTALL_PREFIX=/usr \
        ..
    cmake --build .
    cmake --install .
    cd /
    rm -rf /tmp/box2d

    # Download the current Pogosim main branch directly inside the image.
    # This replaces the local %files section used by the repository-oriented
    # definition and makes this definition self-contained for remote builders.
    git clone --depth 1 --branch main https://github.com/Adacoma/pogosim.git /opt/pogosim

    # Compile and install Pogosim.
    cd /opt/pogosim
    git checkout 55c7076ae9c2af80469908e947ef8ef01a7bdb0b
    ./build.sh

    # Download, compile, and install pogo-utils.
    cd /opt
    git clone https://github.com/Adacoma/pogo-utils.git
    cd /opt/pogo-utils
    ln -s /opt/pogosim pogosim
    ./build.sh

    # Packages required to compile Pogobot binaries.
    apt-get install -y \
        wget \
        bison \
        build-essential \
        clang \
        clang-format \
        cmake \
        flex \
        gawk \
        git \
        graphviz \
        libboost-all-dev \
        libboost-dev \
        libboost-filesystem-dev \
        libboost-iostreams-dev \
        libboost-program-options-dev \
        libboost-python-dev \
        libboost-system-dev \
        libboost-thread-dev \
        libeigen3-dev \
        libffi-dev \
        libftdi-dev \
        libreadline-dev \
        mercurial \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-setuptools \
        tcl-dev \
        xdot \
        zlib1g-dev

    apt-get remove -y python3-numpy || true
    rm -f /usr/lib/python3.*/EXTERNALLY-MANAGED
    pip3 install meson==0.64.1 ninja

    # Install the current pogobatch package from the cloned Pogosim tree.
    cd /opt/pogosim
    find scripts -name '*.pyc' -delete
    find scripts -name '__pycache__' -type d -exec rm -rf {} +
    rm -rf scripts/build scripts/dist scripts/*.egg-info
    cd /opt/pogosim/scripts
    pip3 install -r requirements.txt
    python3 setup.py sdist bdist_wheel
    pip3 install -U .

    # Install the Pogobot SDK and its LiteX dependencies.
    cd /
    git clone https://github.com/leo-cazenille/pogobot-sdk.git
    cd /pogobot-sdk
    mkdir -p dependencies/litex
    cd dependencies/litex
    wget https://raw.githubusercontent.com/enjoy-digital/litex/master/litex_setup.py
    chmod +x litex_setup.py
    ./litex_setup.py init
    cat ../../tools/litex_version.txt | awk '{ if(!system("test -d " $1)) {system("git -C " $1 " checkout " $3)}}'
    rm -f /usr/lib/python3.*/EXTERNALLY-MANAGED
    ./litex_setup.py install

    # Install the RISC-V cross compiler used by the Pogobot SDK.
    cd /pogobot-sdk/tools
    wget https://static.dev.sifive.com/dev-tools/freedom-tools/v2020.08/riscv64-unknown-elf-gcc-10.1.0-2020.08.2-x86_64-linux-ubuntu14.tar.gz
    tar xvf riscv64-unknown-elf-gcc-10.1.0-2020.08.2-x86_64-linux-ubuntu14.tar.gz
    rm -f riscv64-unknown-elf-gcc-10.1.0-2020.08.2-x86_64-linux-ubuntu14.tar.gz

    # Clean package caches and transient downloads.
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    rm -f /apache-arrow-apt-source-latest-*.deb
